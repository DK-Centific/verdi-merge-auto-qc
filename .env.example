# Copy to .env locally if you want. Never commit real secrets.
# Production (Render): set the same keys in the service Environment tab.

# Live Vendor Prod Files workbook (Rate Approval Log destination)
SHAREPOINT_VENDOR_PROD_URL=https://digitaltechedge.sharepoint.com/:x:/r/sites/Verdi_Juniper/Shared%20Documents/Vendor%20Audio%20Production/Vendor%20Prod%20Files.xlsx
SHAREPOINT_SITE_HOSTNAME=digitaltechedge.sharepoint.com
SHAREPOINT_SITE_PATH=sites/Verdi_Juniper
SHAREPOINT_FILE_PATH=Vendor Audio Production/Vendor Prod Files.xlsx

# Microsoft Graph auth — pick ONE:
# A) App-only (recommended on Render)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# B) Pre-issued Graph bearer token (short-lived; useful for a laptop test)
# SHAREPOINT_GRAPH_TOKEN=

# Optional: fail Send unless SharePoint is used (no local fallback)
# SHAREPOINT_REQUIRE=false

# Local demo fallback path (default: masters/Vendor Prod Files.xlsx)
# Used only when SharePoint URL/auth is not configured, or force_local=1
